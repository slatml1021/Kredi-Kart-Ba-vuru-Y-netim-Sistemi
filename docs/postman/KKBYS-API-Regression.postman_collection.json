    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Officer Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"registrationNumber\": \"{{officerRegistrationNumber}}\",\n  \"password\": \"{{officerPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Memur girişi 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "pm.expect(body.user.roles).to.include('Officer');",
              "pm.environment.set('officerToken', body.accessToken);"
